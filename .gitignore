# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/.next-prod/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env files. Ignore every .env variant, then allow the example back in,
# so a stray backup like .env.something can never be committed by accident.
.env*
!.env.example

# prisma
/prisma/dev.db
/prisma/dev.db-journal

# Temporary copy of the old Pages Router during the App Router migration.
# The originals stay in git history; this folder is reference only.
/legacy/

# Local backups that live in the working folder but do not belong in the repo.
# ".git - Copy" is a 112MB copy of the object store.
/.git - Copy/
/package - Copy.json
/public/assets - Copy/

# Database dumps from scripts/db-export.mjs. They carry the admin password
# hash and every site setting, so they stay out of the repository.
/prisma/export.json
/prisma/*.backup.json
